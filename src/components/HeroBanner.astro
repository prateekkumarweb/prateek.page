---
import { Image } from "astro:assets";

const profileImageUrl = "https://static.prateek.page/images/profile.jpg";
---

<div
  class="flex flex-col-reverse items-start gap-6 py-6 sm:flex-row sm:items-center sm:justify-between"
>
  <div>
    <p class="text-xl font-semibold text-slate-800 dark:text-slate-100">
      Senior Software Engineer
    </p>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      <a
        href="https://astratech.ae/"
        target="_blank"
        class="hover:text-primary dark:hover:text-primary-muted no-underline"
        >Astra Tech</a
      > &middot; Abu Dhabi, UAE
    </p>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      Rust &middot; Distributed Systems &middot; Compilers &amp; Programming
      Languages
    </p>
  </div>
  <Image
    src={profileImageUrl}
    alt="Prateek Kumar"
    width={96}
    height={96}
    class="rounded-full ring-2 ring-slate-100 dark:ring-slate-800"
  />
</div>
