---
import ThemeToggle from "./ThemeToggle.astro";
import IconGitHub from "~icons/simple-icons/github";
import IconBluesky from "~icons/simple-icons/bluesky";
import IconX from "~icons/simple-icons/x";
import IconLinkedIn from "~icons/simple-icons/linkedin";
---

<header class="border-b border-slate-300 py-4 dark:border-slate-700">
  <div class="flex items-center justify-between">
    <a
      href="/"
      class="text-primary text-sm font-semibold no-underline hover:opacity-75 dark:text-white"
    >
      Prateek Kumar
    </a>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2.5 text-slate-500 dark:text-slate-400">
        <a
          href="https://github.com/prateekkumarweb"
          target="_blank"
          aria-label="GitHub"
          rel="me"
          class="hover:text-primary transition-colors dark:hover:text-white"
          ><IconGitHub /></a
        >
        <a
          href="https://bsky.app/profile/prateek.page"
          target="_blank"
          aria-label="Bluesky"
          rel="me"
          class="hover:text-primary transition-colors dark:hover:text-white"
          ><IconBluesky /></a
        >
        <a
          href="https://www.linkedin.com/in/prateekkumarweb/"
          target="_blank"
          aria-label="LinkedIn"
          rel="me"
          class="hover:text-primary transition-colors dark:hover:text-white"
          ><IconLinkedIn /></a
        >
        <a
          href="https://x.com/prateekkumarweb"
          target="_blank"
          aria-label="X"
          rel="me"
          class="hover:text-primary transition-colors dark:hover:text-white"
          ><IconX /></a
        >
      </div>
      <ThemeToggle />
    </div>
  </div>
</header>
