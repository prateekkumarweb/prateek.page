---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-4 py-2 text-base">
  {
    tags.map((tag) => (
      <div class="rounded-full bg-gray-300 font-semibold text-gray-700">
        <span class="inline-block px-2">{tag}</span>
      </div>
    ))
  }
</div>
