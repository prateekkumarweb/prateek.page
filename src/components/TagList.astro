---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <span class="bg-primary/10 text-primary dark:bg-primary-muted/20 dark:text-primary-muted rounded-full px-3 py-0.5 text-xs font-medium">
        {tag}
      </span>
    ))
  }
</div>
