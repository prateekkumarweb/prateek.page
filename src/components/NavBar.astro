---
import ThemeToggle from "./ThemeToggle.astro";
import IconGitHub from "~icons/simple-icons/github";
import IconBluesky from "~icons/simple-icons/bluesky";
import IconX from "~icons/simple-icons/x";
import IconLinkedIn from "~icons/simple-icons/linkedin";
---

<nav
  class="flex items-center justify-between border-b border-slate-200 py-4 dark:border-slate-800"
>
  <a
    href="/posts/"
    class="hover:text-primary text-sm font-medium text-slate-600 no-underline transition-colors dark:text-slate-300 dark:hover:text-white"
  >
    Posts
  </a>

  <div class="flex items-center gap-4">
    <div class="flex items-center gap-3 text-slate-400 dark:text-slate-500">
      <a
        rel={Astro.url.pathname === "/" ? "me" : ""}
        href="https://github.com/prateekkumarweb"
        target="_blank"
        title="GitHub"
        aria-label="GitHub"
        class="hover:text-primary transition-colors dark:hover:text-white"
      >
        <IconGitHub />
      </a>
      <a
        rel={Astro.url.pathname === "/" ? "me" : ""}
        href="https://bsky.app/profile/prateek.page"
        target="_blank"
        title="Bluesky"
        aria-label="Bluesky"
        class="hover:text-primary transition-colors dark:hover:text-white"
      >
        <IconBluesky />
      </a>
      <a
        rel={Astro.url.pathname === "/" ? "me" : ""}
        href="https://www.linkedin.com/in/prateekkumarweb/"
        target="_blank"
        title="LinkedIn"
        aria-label="LinkedIn"
        class="hover:text-primary transition-colors dark:hover:text-white"
      >
        <IconLinkedIn />
      </a>
      <a
        rel={Astro.url.pathname === "/" ? "me" : ""}
        href="https://x.com/prateekkumarweb"
        target="_blank"
        title="X"
        aria-label="X"
        class="hover:text-primary transition-colors dark:hover:text-white"
      >
        <IconX />
      </a>
    </div>
    <ThemeToggle />
  </div>
</nav>
