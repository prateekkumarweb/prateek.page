---
import "../styles/global.css";
import Footer from "@/components/Footer.astro";
import SiteHeader from "@/components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string | undefined;
}

const {
  title = "Prateek Kumar",
  description = "Prateek Kumar | Software Engineer | Rust and JavaScript",
  image = "https://static.prateek.page/images/profile.jpg",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123456" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..700;1,14..32,300..700&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Prateek" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={Astro.url} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        const theme = localStorage.getItem("color-scheme") || "system";
        if (
          theme === "dark" ||
          (theme === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <style is:global>
      svg.icon {
        @apply inline;
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-white font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-6">
      <SiteHeader />
      <main class="grow py-10">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
