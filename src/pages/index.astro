---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroBanner from "@/components/HeroBanner.astro";
import Profile from "@/components/Profile.astro";
import { getCollection } from "astro:content";
import PostList from "@/components/PostList.astro";

const recentPosts = (await getCollection("post"))
  .filter((p) => p.data.publish)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout>
  <HeroBanner />

  <hr class="my-8 border-slate-300 dark:border-slate-700" />

  <Profile />

  <hr class="my-8 border-slate-300 dark:border-slate-700" />

  <section>
    <h2
      class="text-primary dark:text-primary-muted mb-4 text-xs font-semibold tracking-widest uppercase"
    >
      Recent Posts
    </h2>
    <PostList posts={recentPosts} limit={5} />
    <a
      href="/posts/"
      class="text-primary dark:text-primary-muted mt-4 inline-block text-sm font-medium no-underline hover:underline"
    >
      View all posts →
    </a>
  </section>
</BaseLayout>
